c4cd233b7379aa2d371e33494e77ce5b15a11406f67104b7d52daa2cf19ee085:{"__metadata":{"version":0.1},"root":{"steps":[{"step_id":"66ff75db-afe6-48a7-92fe-b206b3c0ac2c","step_position":[0,0],"config_field_values":[],"task_id":"shopify::admin::product_added","task_version":"0.1","task_type":"TRIGGER","description":null,"note":null,"name":null},{"step_id":"5509de75-5e6f-4d15-80e3-945a2fc8971e","step_position":[0,180],"config_field_values":[{"config_field_id":"input","value":"query {\n  product {\n    id\n    tags\n  }\n}"},{"config_field_id":"script","value":"export default function main(input) {\n  const sku = input.product.tags.find(tag => tag.startsWith('sku-'));\n  const baseSku = sku ? sku.split(' ')[0] : '';\n  \n  return {\n    baseSku: baseSku\n  };\n}"},{"config_field_id":"output_schema","value":"type Output {\n  baseSku: String!\n}"}],"task_id":"shopify::flow::run_code","task_version":"0.1","task_type":"ACTION","description":null,"note":null,"name":"Run code"},{"step_id":"05daa293-4369-43e8-8bce-c3bfd387a651","step_position":[0,320],"config_field_values":[{"config_field_id":"query","value":"tag:{{ runCode.baseSku }}"},{"config_field_id":"max_root_records","value":"100"},{"config_field_id":"sort_by","value":"{\"sortKey\":\"CREATED_AT\",\"order\":\"ASCENDING\"}"}],"task_id":"shopify::flow::fetch::products","task_version":"v1","task_type":"ACTION","description":null,"note":null,"name":"Get product data"},{"step_id":"12672c9b-fd3e-4865-8d15-71a2ffe08e17","step_position":[0,500],"config_field_values":[{"config_field_id":"listpath","value":"getProductData"}],"task_id":"shopify::flow::foreach","task_version":"0.1","task_type":"FOREACH","description":null,"note":null,"name":null},{"step_id":"604413b9-e6d1-4517-b738-82da55366bdc","step_position":[0,700],"config_field_values":[{"config_field_id":"product_id","value":"{\"value\":\"{{getProductDataForeachitem.id}}\",\"default_value\":\"{{getProductDataForeachitem.id}}\"}"},{"config_field_id":"metafield","value":"{\"namespace\":\"custom\",\"key\":\"product_variations\",\"type\":\"list.product_reference\"}"},{"config_field_id":"value","value":"{% assign ids = '' %}{% for p in getProductData %}{% if p.id != getProductDataForeachitem.id %}{% if ids != '' %}{% assign ids = ids | append: ',\"' %}{% else %}{% assign ids = '\"' %}{% endif %}{% assign ids = ids | append: p.id | append: '\"' %}{% endif %}{% endfor %}[{{ ids }}]"}],"task_id":"shopify::admin::add_product_metafield","task_version":"1.0","task_type":"ACTION","description":null,"note":null,"name":null}],"links":[{"from_step_id":"66ff75db-afe6-48a7-92fe-b206b3c0ac2c","from_port_id":"output","to_step_id":"5509de75-5e6f-4d15-80e3-945a2fc8971e","to_port_id":"input"},{"from_step_id":"5509de75-5e6f-4d15-80e3-945a2fc8971e","from_port_id":"output","to_step_id":"05daa293-4369-43e8-8bce-c3bfd387a651","to_port_id":"input"},{"from_step_id":"05daa293-4369-43e8-8bce-c3bfd387a651","from_port_id":"output","to_step_id":"12672c9b-fd3e-4865-8d15-71a2ffe08e17","to_port_id":"input"},{"from_step_id":"12672c9b-fd3e-4865-8d15-71a2ffe08e17","from_port_id":"loop_body","to_step_id":"604413b9-e6d1-4517-b738-82da55366bdc","to_port_id":"input"}],"patched_fields":[],"variables":[],"note":null,"vertical_layout_enabled":true,"workflow_name":"Auto-link product variants by SKU tag"}}